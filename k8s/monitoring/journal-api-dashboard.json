{
  "uid": "journal-api",
  "title": "Journal API",
  "description": "Application metrics collected by Prometheus. Health probes are excluded. No data does not mean the application is healthy.",
  "tags": ["journal-api", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "description": "Average requests per second across all Journal API Pods. rate() handles counter resets after restarts. Health probes are excluded.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{namespace=\"journal-api\", service=\"journal-api-metrics\"}[$__rate_interval]))",
          "legendFormat": "Requests / second",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Average HTTP response time",
      "description": "Total request duration divided by request count, across all Pods. The current OpenTelemetry instrumentation exports duration in milliseconds. No requests means no meaningful average.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_sum{namespace=\"journal-api\", service=\"journal-api-metrics\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{namespace=\"journal-api\", service=\"journal-api-metrics\"}[$__rate_interval]))",
          "legendFormat": "Average response time",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx error percentage",
      "description": "5xx responses divided by all responses. With traffic but no 5xx series, the numerator is zero. No traffic or missing request metrics does not mean a healthy 0% error rate.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_duration_milliseconds_count{namespace=\"journal-api\", service=\"journal-api-metrics\", http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_duration_milliseconds_count{namespace=\"journal-api\", service=\"journal-api-metrics\"}[$__rate_interval]))",
          "legendFormat": "5xx responses",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Entries created (selected time range)",
      "description": "Estimated increase of the custom counter over the selected time range, summed across Pods and adjusted for resets. This is not the current row count in RDS. New series need at least two samples; writes before the first sample may not be counted.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 1 },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(journal_api_entries_created_total{namespace=\"journal-api\", service=\"journal-api-metrics\"}[$__range]))",
          "legendFormat": "Entries created",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Ready / desired application Pods",
      "description": "Current ready and desired Deployment replicas, reported by kube-state-metrics. Ready means the Pod passed its readiness check; it does not prove RDS or OpenAI works.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"journal-api\", deployment=\"journal-api\"}",
          "legendFormat": "Ready",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "kube_deployment_spec_replicas{namespace=\"journal-api\", deployment=\"journal-api\"}",
          "legendFormat": "Desired",
          "instant": true,
          "range": false
        }
      ]
    }
  ]
}
