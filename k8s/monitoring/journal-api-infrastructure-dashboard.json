{
  "uid": "journal-api-infrastructure",
  "title": "EKS resources",
  "description": "Select a namespace and Pod. CPU/memory panels repeat for each selected container. The restart table covers the namespace; worker panels cover the whole cluster.",
  "tags": ["journal-api", "kubernetes", "prometheus"],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "custom",
        "query": "journal-api,monitoring,amazon-cloudwatch,kube-system",
        "current": { "text": "monitoring", "value": "monitoring" }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 3,
          "query": "query_result(max by (pod) (kube_pod_container_info{namespace=\"$namespace\"}))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/pod=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "container",
        "label": "Containers",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 3,
          "query": "query_result(max by (container) (kube_pod_container_info{namespace=\"$namespace\", pod=\"$pod\"}))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/container=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU - $container",
      "description": "One container in the selected Pod: usage and configured limit. 0.3 cores = 300m. No limit line means no configured CPU limit.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "repeat": "container",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "cores", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=\"$pod\", container=~\"${container:regex}\", metrics_path=\"/metrics/cadvisor\"}[$__rate_interval]))",
          "legendFormat": "Usage",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", container=~\"${container:regex}\", resource=\"cpu\", unit=\"core\"})",
          "legendFormat": "Limit",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM - $container",
      "description": "One container in the selected Pod: memory working set and configured limit. Working set is not an exact OOM threshold.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "repeat": "container",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=\"$pod\", container=~\"${container:regex}\", metrics_path=\"/metrics/cadvisor\"})",
          "legendFormat": "Usage",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", container=~\"${container:regex}\", resource=\"memory\", unit=\"byte\"})",
          "legendFormat": "Limit",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Container restarts - $namespace",
      "description": "Current restart counts for all Pods/containers in the namespace, not just the selected Pod. A replacement Pod starts a new counter; restarts do not necessarily mean OOM.",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Restarts", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "pod": 0, "container": 1, "Value": 2 },
            "renameByName": { "pod": "Pod", "container": "Container", "Value": "Restarts" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, container) (kube_pod_container_status_restarts_total{namespace=\"$namespace\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker CPU non-idle (%) - all workers",
      "description": "CPU non-idle percentage for each worker, including the OS and all namespaces.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Worker memory in use (%) - all workers",
      "description": "Whole-worker memory use: 100 * (MemTotal - MemAvailable) / MemTotal. Includes the OS and all namespaces.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    }
  ]
}
