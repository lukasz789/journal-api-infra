{
  "uid": "journal-api-infrastructure",
  "title": "EKS resources",
  "description": "CPU, memory and restarts. Select a namespace for containers; worker panels always show the whole cluster.",
  "tags": ["journal-api", "kubernetes", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace (container panels)",
        "type": "custom",
        "query": "journal-api,monitoring,amazon-cloudwatch,kube-system",
        "current": { "text": "monitoring", "value": "monitoring" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Container CPU usage / limit",
      "description": "CPU usage and limit for each container. 0.3 cores = 300m. Containers without a configured limit have no limit line.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "cores", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\", metrics_path=\"/metrics/cadvisor\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{container}} usage",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\", unit=\"core\"})",
          "legendFormat": "{{pod}} / {{container}} limit",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Container memory working set / limit",
      "description": "Memory working set and configured limit for each container. Working set is not an exact OOM threshold.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\", metrics_path=\"/metrics/cadvisor\"})",
          "legendFormat": "{{pod}} / {{container}} working set",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\", unit=\"byte\"})",
          "legendFormat": "{{pod}} / {{container}} limit",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Container restarts",
      "description": "Restart counter for each container. A replacement Pod starts a new counter; restarts do not necessarily mean OOM.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}} / {{container}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker CPU non-idle (%) - all workers",
      "description": "CPU non-idle percentage for each worker, including the OS and all namespaces.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Worker memory in use (%) - all workers",
      "description": "Whole-worker memory use: 100 * (MemTotal - MemAvailable) / MemTotal. Includes the OS and all namespaces.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    }
  ]
}
